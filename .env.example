# Core application configuration (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crossguild"
AUTH_SECRET="replace-with-a-random-secret"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# OAuth providers (optional, but each provider requires both values)
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_ID=""
GOOGLE_SECRET=""

# Transactional email (required for email verification and password reset emails)
RESEND_API_KEY=""
EMAIL_FROM="CrossGuild <noreply@example.com>"

# Media uploads (required for product and profile image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# E2E-only overrides
E2E_USER_NAME="E2E User"
E2E_USER_EMAIL="e2e-user@crossguild.test"
E2E_USER_PASSWORD="e2e-password-123"
